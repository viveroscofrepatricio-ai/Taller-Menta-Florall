---
import testimoniosData from '../data/testimonios.json';

function getInit(nombre: string) {
  return nombre.charAt(0).toUpperCase();
}
---
<section class="testimonials">
  <div class="section-head">
    <div class="section-eyebrow">Lo que dicen</div>
    <h2 class="section-title">Hablamos como amigas,<br/>con <em>calidez y empatía.</em></h2>
    <div class="section-aside">Reseñas de alumnas que pasaron por el taller.</div>
  </div>
  <div class="testi-grid">
    {testimoniosData.map(t => (
      <article class="testi-card">
        <div class="mark">"</div>
        <div class="stars" aria-label="5 estrellas">
          {[...Array(5)].map(() => (
            <svg viewBox="0 0 24 24"><path d="M12 2l2.9 6.9L22 10l-5.5 4.8L18 22l-6-3.5L6 22l1.5-7.2L2 10l7.1-1.1z"/></svg>
          ))}
        </div>
        <div class="quote">{t.reseña}</div>
        <div class="author">
          <div class="av">{getInit(t.nombre)}</div>
          <div>
            <div class="name">{t.nombre}</div>
            <div class="role">{t.rol}</div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
